<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=2">
    <script src="{{ asset(prefix|trim('/', 'right') ~ '/bundles/fmelfinder/js/elfinderCallback.js') }}"></script>
    <script data-main="{{ path('ef_main_js') }}" src="//cdnjs.cloudflare.com/ajax/libs/require.js/2.3.6/require.min.js"></script>
    <script>
        define('elFinderConfig', {
            defaultOpts: {
                url: {{ path('ef_connect', {instance: instance, homeFolder: homeFolder})|json_encode|raw }},
                lang: {{ locale|json_encode|raw }},
                onlyMimes: {{ onlyMimes|raw }},
                getFileCallback: function (files) {
                    if (typeof window.FMElfinderCallback === 'undefined') {
                        window.alert('FMElfinderBundle: elfinderCallback.js could not be loaded. Run "bin/console elfinder:install" and "bin/console assets:install", then retry.');
                        return;
                    }
                    try {
                        window.FMElfinderCallback.callOpener(files, {{ callbackFunction|json_encode|raw }}, {
                            multiple: {{ multiple ? 'true' : 'false' }},
                            relativePath: {{ relative_path ? 'true' : 'false' }},
                            pathPrefix: {{ pathPrefix|json_encode|raw }},
                            origin: {{ app.request.schemeAndHttpHost|json_encode|raw }} + '/'
                        });
                    } catch (error) {
                        window.FMElfinderCallback.showError(error, document);
                    }
                },
                commandsOptions: {
                    getfile: {
                        multiple: {{ multiple ? 'true' : 'false' }}
                    },
                    edit: {
                        extraOptions: {
                            creativeCloudApiKey: '',
                            managerUrl: ''
                        }
                    }
                },
                bootCallback: function (fm) {
                    var title = document.title;
                    fm.bind('open', function () {
                        var cwd = fm.cwd();
                        var currentPath = cwd ? fm.path(cwd.hash) || null : '';
                        document.title = currentPath ? currentPath + ':' + title : title;
                    }).bind('destroy', function () {
                        document.title = title;
                    });
                }
            },
            managers: {
                elfinder: {}
            }
        });
    </script>
</head>
<body>
<div id="fm-elfinder-callback-error" role="alert" hidden></div>
<div id="elfinder"></div>
</body>
</html>
